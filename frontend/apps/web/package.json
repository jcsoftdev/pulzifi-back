{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='' next dev --turbopack -p ${PORT:-3001}",
    "dev:https": "NODE_OPTIONS='' next dev --turbopack -p ${PORT:-3001} --experimental-https --experimental-https-key ./localhost+3-key.pem --experimental-https-cert ./localhost+3.pem",
    "build": "next build",
    "start": "next start",
        "start:prod": "bunx tsx scripts/cms-migrate.ts && next start -p ${PORT:-8080}",
    "type-check": "tsc --noEmit",
    "type-check:fast": "tsgo --noEmit",
    "test": "bun test features/cms",
    "format": "biome format ../../ --write",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:migrate": "bunx tsx scripts/cms-migrate.ts",
    "cms:seed": "curl -s -X POST http://localhost:${PORT:-3001}/api/seed-cms -H \"x-seed-secret: $SEED_SECRET\" | jq .",
    "cms:migrate:seed": "bun run cms:migrate && bun run cms:seed"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/live-preview": "^3.84.1",
    "@payloadcms/live-preview-react": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@workspace/notix": "workspace:*",
    "@workspace/services": "workspace:*",
    "@workspace/shared-http": "workspace:*",
    "@workspace/ui": "workspace:*",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.574.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "payload": "^3.84.1",
    "react": "^19.2.4",
    "react-colorful": "^5.6.2",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@workspace/typescript-config": "workspace:*",
    "sass": "^1.77.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
