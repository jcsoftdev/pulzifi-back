# PULZIFI — copy this to .env and fill in your values
# Required vars marked [REQUIRED] will crash the server if missing.

# ENVIRONMENT
# Dev: development | Production: production
ENVIRONMENT=development
LOG_LEVEL=info

# DATABASE [REQUIRED]
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SERVER
# Local host API port. tools/scripts/assign-dev-ports.sh rewrites it if busy.
HTTP_PORT=3000
GRPC_PORT=9000
ENABLE_WORKERS=true
# Dev-only host ports for services that keep fixed container-internal ports.
DEV_WEB_PORT=3001
SCRAPER_PORT=3005
# API key required by the scraper for all POST requests. Leave empty in dev (auth disabled).
# Must match Go side EXTRACTOR_API_KEY. In production: generate with openssl rand -hex 32.
SCRAPER_API_KEY=
DEV_REDIS_PORT=6381
LOCALSTACK_PORT=4566
# Dev: http://localhost:<HTTP_PORT> | Production: https://app.pulzifi.com
FRONTEND_URL=
# Dev: (empty) | Production: .pulzifi.com
COOKIE_DOMAIN=
# Apex application domain. Requests on the apex carry no tenant (avoids
# mis-resolving e.g. pulzifi.com -> org "pulzifi" -> 403). Optional: when empty
# it is derived from FRONTEND_URL's host. Dev: (empty) | Production: pulzifi.com
APP_DOMAIN=
# Dev: http://localhost:<DEV_WEB_PORT> | Production: http://localhost:3001 (internal sidecar)
NEXTJS_URL=http://localhost:3001

# CORS [REQUIRED]
# Dev: generated by tools/scripts/assign-dev-ports.sh
# Production: https://app.pulzifi.com,https://*.pulzifi.com
CORS_ALLOWED_ORIGINS=

# AUTH [REQUIRED]
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Ollama (section naming for change diffs). Optional.
# Dev macOS: run Ollama NATIVELY (brew install ollama; ollama pull qwen3:4b) and use:
#   OLLAMA_URL=http://host.docker.internal:11434
# Prod (Linux/Docker): OLLAMA_URL=http://ollama:11434
OLLAMA_ENABLED=false
OLLAMA_URL=
OLLAMA_MODEL=qwen3:4b

# EXTRACTOR [REQUIRED]
# Docker: http://scraper:3000 | Prod: http://scraper:3000 (Dokploy internal network)
EXTRACTOR_URL=
# Service-to-service API key. Scraper rejects requests without a matching X-API-Key header.
# Must match SCRAPER_API_KEY on the scraper container. Leave empty in dev (auth disabled).
EXTRACTOR_API_KEY=

# OBJECT STORAGE
OBJECT_STORAGE_PROVIDER=minio

# MinIO / LocalStack
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=

# Cloudinary (alternative)
# OBJECT_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# REDIS (optional — graceful degradation if unset)
# Docker: redis | VPS: internal Dokploy hostname
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# AI INSIGHTS (OpenRouter, optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# EMAIL (Resend, optional)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# OAUTH (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dev: http://localhost:<HTTP_PORT> | Production: https://app.pulzifi.com
OAUTH_REDIRECT_BASE_URL=

# INTEGRATIONS
# 32-byte hex; required if any integration provider configured. Encrypts at-rest tokens AND signs OAuth state (Phase 1).
INTEGRATION_TOKEN_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Used for two purposes:
#   1. Constructing the Slack redirect_uri sent to Slack (must be localhost in dev — Slack rejects .local TLDs)
#   2. Fallback redirect URL when OAuth state cannot be verified
# The post-OAuth redirect to the tenant's subdomain is built dynamically from the
# origin captured at flow initiation, not from this variable.
INTEGRATION_OAUTH_REDIRECT_BASE=http://localhost:3000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_POLL_INTERVAL=5s
DELIVERY_WORKER_POOL_SIZE=10

# DISCORD (optional — enables Discord card if both set)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# TWILIO (paid tier uses these platform credentials; enterprise tier uses BYO via /integrations/connect)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated plan codes that grant access to the platform Twilio account.
TWILIO_PAID_PLANS=pro,business

# GMAIL INTEGRATION
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# Before enabling: add gmail.send scope and this callback URI to Google Console OAuth consent screen:
#   {INTEGRATION_OAUTH_REDIRECT_BASE}/api/v1/integrations/oauth/gmail/callback
# The existing Google Login redirect URI is separate and unaffected.
# Default false prevents a broken card when Google Login is configured but gmail.send scope is not.
GMAIL_INTEGRATION_ENABLED=false

# MICROSOFT / OUTLOOK (optional — enables Outlook card if both set)
# Azure portal: register app, set supported accounts to "work/school", add Mail.Send delegated permission.
#   Callback URI: {INTEGRATION_OAUTH_REDIRECT_BASE}/api/v1/integrations/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# PAYLOAD CMS (frontend embedded admin at /cms-admin)
# Required: secret used to sign Payload JWTs. Min 32 chars in production.
PAYLOAD_SECRET=
# Public URL Payload uses to build absolute links inside the admin (cookie-domain aware).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated origins allowed by Payload CSRF + CORS (admin runs through Go proxy on :3000).
PAYLOAD_CSRF_ORIGINS=http://localhost:3000,http://localhost:3001

BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_51TUthp2QlH4...
STRIPE_PUBLISHABLE_KEY=pk_test_51TUthp2QlH4...
STRIPE_WEBHOOK_SECRET=whsec_local_...           # del stripe listen output
STRIPE_PORTAL_RETURN_URL=http://localhost:3002/billing
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3002/billing?success=true
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3002/billing?canceled=true
# Trial (self-serve onboarding)
TRIAL_DAYS=14
TRIAL_CHECKS_PER_MONTH=500
TRIAL_EXPIRY_CRON="0 0 * * *"
