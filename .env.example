# PULZIFI — copy this to .env and fill in your values
# Required vars marked [REQUIRED] will crash the server if missing.

# ENVIRONMENT
# Dev: development | Production: production
ENVIRONMENT=development
LOG_LEVEL=info

# DATABASE [REQUIRED]
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SERVER
HTTP_PORT=3000
ENABLE_WORKERS=true
# Dev: http://localhost:3000 | Production: https://app.pulzifi.com
FRONTEND_URL=
# Dev: (empty) | Production: .pulzifi.com
COOKIE_DOMAIN=
# Dev: http://localhost:3001 | Production: http://localhost:3001 (internal sidecar)
NEXTJS_URL=http://localhost:3001

# CORS [REQUIRED]
# Dev: http://localhost:3000,http://*.localhost:3000
# Production: https://app.pulzifi.com,https://*.pulzifi.com
CORS_ALLOWED_ORIGINS=

# AUTH [REQUIRED]
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# EXTRACTOR [REQUIRED]
# Docker: http://scraper:3000 | Prod: http://scraper:3000 (Dokploy internal network)
EXTRACTOR_URL=

# OBJECT STORAGE
OBJECT_STORAGE_PROVIDER=minio

# MinIO / LocalStack
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=

# Cloudinary (alternative)
# OBJECT_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# REDIS (optional — graceful degradation if unset)
# Docker: redis | VPS: internal Dokploy hostname
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# AI INSIGHTS (OpenRouter, optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# EMAIL (Resend, optional)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# OAUTH (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dev: http://localhost:3000 | Production: https://app.pulzifi.com
OAUTH_REDIRECT_BASE_URL=

# INTEGRATIONS
# 32-byte hex; required if any integration provider configured. Encrypts at-rest tokens AND signs OAuth state (Phase 1).
INTEGRATION_TOKEN_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Used for two purposes:
#   1. Constructing the Slack redirect_uri sent to Slack (must be localhost in dev — Slack rejects .local TLDs)
#   2. Fallback redirect URL when OAuth state cannot be verified
# The post-OAuth redirect to the tenant's subdomain is built dynamically from the
# origin captured at flow initiation, not from this variable.
INTEGRATION_OAUTH_REDIRECT_BASE=http://localhost:3000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_POLL_INTERVAL=5s
DELIVERY_WORKER_POOL_SIZE=10

# DISCORD (optional — enables Discord card if both set)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# TWILIO (paid tier uses these platform credentials; enterprise tier uses BYO via /integrations/connect)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated plan codes that grant access to the platform Twilio account.
TWILIO_PAID_PLANS=pro,business
