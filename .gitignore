# ============================================================
# .gitignore - Git ignore patterns
# ============================================================

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
/bin/
/dist/
migrate
*.o
*.a
*.so
.exe

# Frontend build artifacts
**/.next/
**/.turbo/
**/out/
frontend/apps/web/.env.local

# Go
go.mod.lock

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
/tmp/

# Docker
docker-compose.override.yml

# SSL Certificates (but keep the directory)
ssl/*.pem
!ssl/.gitkeep

# Database
*.sql
!database_setup.sql
!update_admin_password.sql
!shared/database/migrations/**/*.sql
*.db
*.sqlite

# Backups
backups/
*.backup
*.bak

# OS
.DS_Store
Thumbs.db

# IDE specific
*.iml
.gradle
.gradle/
out/

# Dependencies
vendor/
node_modules/

# Test coverage
coverage.out
coverage.html
*.cover


tmp

/docs/superpowers/*

/.trae

/.superpowers/
/.playwright-mcp/
"SKILL (9).md"
.claude/scheduled_tasks.lock

/client_*
.worktrees/
modules/*/docs/
# Local Pi runtime state
.atl/
.pi/

# Codegraph MCP index
.codegraph/

# Local Go build output (entry-point binaries at repo root)
/server
/pulzifi-monolith
/pulzifi-worker

# Air hot-reload build cache
tmp/
volume/tmp/
build-errors.log
build-errors-worker.log
