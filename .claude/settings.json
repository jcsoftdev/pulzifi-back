{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)",
      "Bash(bun run:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun dev:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "project-brain search --stdin",
            "timeout": 8,
            "statusMessage": "project-brain: injecting context"
          }
        ]
      }
    ]
  },
  "agents": {
    "skillDirs": [
      "./.claude/skills"
    ]
  }
}